    "meeting_prep": {
      "runtime_name": "meeting_prep",
      "successful_ending": "Ordinary preparation delivers the approved account brief and recent-call summaries without a case or separate recording search. Explicit selected-call preparation can produce a private native recommendations draft after its existing approvals and human rendered review.",
      "default_preparation_mode": "account_brief",
      "preparation_modes": {
        "account_brief": {
          "required_steps": [
            "account_brief"
          ],
          "requires_case": false,
          "renderer_required": false,
          "successful_ending": "The approved ordered account brief is displayed with recent-call summaries, recorded next steps, visible limits and authorized charts; absent chart authorization does not block the brief."
        },
        "selected_call": {
          "required_steps": [
            "call_lookup",
            "account_brief",
            "selected_transcript",
            "approved_master_preflight",
            "review_and_private_draft"
          ],
          "requires_case": true,
          "renderer_required": true,
          "successful_ending": "A selected-call recommendations draft retains every existing content, slide-selection, separate draft-authorization and rendered-review gate."
        }
      },
      "source_boundaries": [
        "Authorized Converge call metadata and explicitly selected same-account call",
        "Transient selected transcript; never raw transcript output",
        "Governed AccountIntelligenceCoreV1 evidence independent of CTAs",
        "Approved v3 private master only; supporting templates 8, 11, 12, 14, 16, 17 only when relevant"
      ],
      "approval_gates": [
        "identity",
        "evidence",
        "recommendations",
        "customer_content",
        "maintained_slides",
        "separate_draft_authorization",
        "rendered_review"
      ],
      "timeout_policy": {
        "legacy_range_ms": 100000,
        "legacy_exact_date_ms": 120000,
        "evidence_statement_ms": 120000,
        "evidence_window_ms": 300000,
        "recovery_window_ms": 300000
      },
      "steps": [
        {
          "step": "call_lookup",
          "tools": [
            "beta_start_converge_call_lookup",
            "beta_continue_meeting_prep_call_lookup",
            "beta_accept_converge_call_candidates",
            "beta_create_meeting_prep_case_from_call_selection"
          ],
          "hostTools": [
            "Converge.list_customer_calls",
            "Converge.search_customer_calls"
          ]
        },
        {
          "step": "account_brief",
          "tools": [
            "beta_start_meeting_prep_account_brief",
            "beta_continue_meeting_prep_account_brief",
            "beta_get_meeting_prep_brief_display",
            "beta_get_account_brief_chart"
          ],
          "observed": true
        },
        {
          "step": "selected_transcript",
          "tools": [
            "beta_get_selected_converge_call_request",
            "beta_bind_converge_call_evidence"
          ],
          "hostTools": [
            "Converge.get_customer_call"
          ]
        },
        {
          "step": "approved_master_preflight",
          "tools": [
            "beta_get_meeting_prep_build_requirements",
            "beta_bind_meeting_prep_master_preflight"
          ],
          "owner": "desktop_host",
          "hostTools": [
            "Approved private v3 builder.captureCsmCopilotApprovedV3Preflight"
          ],
          "creates_artifact": false
        },
        {
          "step": "review_and_private_draft",
          "tools": [
            "beta_bind_recommendation_review_package",
            "beta_reopen_meeting_prep_recommendation_review",
            "beta_prepare_meeting_prep_draft_review",
            "beta_record_approval",
            "beta_render_private_draft"
          ]
        }
